{
  "name": "katbox-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node --env-file-if-exists=.env --watch --import remix/node-tsx server.ts",
    "hmr": "cross-env NODE_ENV=development node --env-file-if-exists=.env hmr.ts",
    "start": "cross-env NODE_ENV=production node --import remix/node-tsx server.ts",
    "test": "cross-env NODE_ENV=test remix test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "mongodb": "^7.7.0",
    "remix": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "cross-env": "^10.1.0",
    "typescript": "latest"
  }
}
