# Copy to .env for local development. Never commit .env.
# Railway: set these in the service's Variables tab instead.

# MongoDB Atlas connection string (required in production)
MONGODB_URI=
MONGODB_DB=katbox

# Production only (set on Railway)
# TRUST_PROXY=1
# SITE_ORIGIN=https://katbox.org

# Public Roblox link for the game button (optional)
# BLADES_OF_CHANCE_URL=https://www.roblox.com/games/...
