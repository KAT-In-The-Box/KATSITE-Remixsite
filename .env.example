# Copy to .env for local development. Never commit real credentials.
# Railway: configure production values in the service's Variables tab.

NODE_ENV=development
PORT=44100
MONGODB_URI=
MONGODB_DB=KatBox
# Collection used by the staff Game Manager (spaces are allowed).
MONGODB_GAMES_COLLECTION=KatBox Collection
SITE_ORIGIN=http://localhost:44100
TRUST_PROXY=0

# Roblox OAuth — keep the client secret server-side only.
ROBLOX_OAUTH_CLIENT_ID=
ROBLOX_OAUTH_CLIENT_SECRET=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
ROBLOX_SESSION_SECRET=
# Comma-separated numeric Roblox user IDs allowed into the staff portal.
ROBLOX_STAFF_USER_IDS=

# Optional public Blades of Chance experience URL.
BLADES_OF_CHANCE_URL=
